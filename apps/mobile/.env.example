# Copy to .env.local. The phone app reads the API address from here; it is never hardcoded.
# Use your computer's LAN address (not localhost) when testing on a real phone.
EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# Needed for push notifications: the Expo (EAS) project id. Create it once with `npx eas init`, then paste it here.
# Without it the app still works; More shows a friendly note instead of the Notifications switch.
EXPO_PUBLIC_EAS_PROJECT_ID=
