# Neon (added automatically by the Vercel Neon integration). Use a dev branch locally.
DATABASE_URL=
# Any long random string. Generate one with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# The production URL in production, http://localhost:3000 locally
BETTER_AUTH_URL=http://localhost:3000
# In Vercel production: BETTER_AUTH_URL=https://juniperbooking.com
# Public marketing URL (used in metadata, sitemap, emails)
NEXT_PUBLIC_SITE_URL=https://juniperbooking.com
# Extra allowed origins for logins, comma separated (optional)
EXTRA_TRUSTED_ORIGINS=
# Evergreen staff who can create businesses at /admin (comma separated emails)
PLATFORM_ADMINS=tegan@evergreendigitalco.com
# Emails (Resend): invites, confirmations, reminders, password resets. Leave blank until set up;
# invite links are then shown on screen to copy instead.
RESEND_API_KEY=
EMAIL_FROM="Juniper <no-reply@juniperbooking.com>"
# Protects the daily reminder cron (Vercel sends it automatically when set)
CRON_SECRET=
