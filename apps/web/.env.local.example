# Neon (added automatically by the Vercel Neon integration). Use a dev branch locally.
DATABASE_URL=
# Any long random string. Generate one with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# The production URL in production, http://localhost:3000 locally
BETTER_AUTH_URL=http://localhost:3000
# Extra allowed origins for logins, comma separated (optional)
EXTRA_TRUSTED_ORIGINS=
# Who can create a login, and their role (owner, manager, member)
APP_TEAM=you@example.com:owner,teammate@example.com:manager
APP_WORKSPACE_NAME=My business
# Password reset emails (Resend). Leave blank until email is set up.
RESEND_API_KEY=
EMAIL_FROM="Your App <no-reply@example.com>"
